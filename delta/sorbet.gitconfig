# Sorbet for delta (the git diff pager), part of cosmic-sorbet-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Sorbet theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/sorbet.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = sorbet

[delta "sorbet"]
    dark = true
    syntax-theme = Sorbet
    navigate = true
    line-numbers = true

    file-style = bold "#B2FFF3"
    file-decoration-style = "#5E616C" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#5E616C" box
    hunk-header-file-style = "#DFBAFF"
    hunk-header-line-number-style = "#FFF6C3"

    minus-style = "#FF9FBC" "#121019"
    minus-emph-style = bold "#05080A" "#FF9FBC"
    minus-non-emph-style = "#FF9FBC" "#121019"
    plus-style = "#BAF7B5" "#121019"
    plus-emph-style = bold "#05080A" "#BAF7B5"
    plus-non-emph-style = "#BAF7B5" "#121019"
    zero-style = syntax
    whitespace-error-style = "#05080A" "#FFC79B"

    line-numbers-left-style = "#5E616C"
    line-numbers-right-style = "#5E616C"
    line-numbers-minus-style = "#FF9FBC"
    line-numbers-plus-style = "#BAF7B5"
    line-numbers-zero-style = "#5E616C"

    commit-style = bold "#FFF6C3"
    commit-decoration-style = "#5E616C" box
    blame-palette = "#05080A #121019 #1A1727"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#BAF7B5"
    merge-conflict-theirs-diff-header-style = bold "#FFC79B"
